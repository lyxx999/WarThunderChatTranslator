<Page
    x:Class="WarThunderChatTranslator.Pages.InteractPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:labs="using:WinUICommunity"
    xmlns:local="using:WarThunderChatTranslator.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Header"
            Margin="0,44,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="互动和操作" />

        <ScrollViewer Grid.Row="1">
            <Grid Padding="0,0,20,0" RowSpacing="0">
                <StackPanel>
                    <labs:SettingsCard
                        MaxWidth="2000"
                        Header="长按回车切换浮窗固定"
                        Description="游戏在前台时，把回车按住到设定时长再松开，即切换浮窗固定显示的开/关；游戏不在前台时不响应">
                        <ToggleSwitch
                            x:Name="EnterTogglePinToggle"
                            OffContent="关"
                            OnContent="开" />
                    </labs:SettingsCard>
                    <labs:SettingsCard
                        MaxWidth="2000"
                        Header="长按回车时长"
                        Description="回车按住多久算作一次「长按」；设得太短会和普通聊天输入误触发">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="HoldSlider"
                                Width="180"
                                Minimum="0.2"
                                Maximum="3"
                                StepFrequency="0.1"
                                Value="0.5" />
                            <NumberBox
                                x:Name="HoldInput"
                                Grid.Column="1"
                                Width="88"
                                Margin="12,0,0,0"
                                Minimum="0.2"
                                Maximum="3"
                                SmallChange="0.1"
                                LargeChange="0.5"
                                SpinButtonPlacementMode="Hidden"
                                ValueChanged="HoldInput_ValueChanged" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="秒" />
                            <Button
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="HoldResetButton_Click"
                                Content="恢复默认"
                                ToolTipService.ToolTip="恢复为 0.5 秒" />
                        </Grid>
                    </labs:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
